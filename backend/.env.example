# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=5000

# Exact origin of the storefront (scheme + host, no trailing slash).
CLIENT_ORIGIN=http://localhost:5173

# Session cookie
JWT_SECRET=generate-a-long-random-string
JWT_EXPIRES_IN=7d
# true in production (HTTPS). Required for cross-site cookies.
COOKIE_SECURE=false

# --- Database: PostgreSQL (Neon) ---
# Neon dashboard -> Connection string -> use the POOLED host (contains "-pooler").
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require
# Leave unset. Set to false only if TLS certificate verification fails.
# DB_SSL_REJECT_UNAUTHORIZED=true
# DB_POOL_MAX=10

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Razorpay rejects any single order above ₹5,00,000. Carts over this are
# refused with a clear message instead of a raw gateway error. Raise only if
# Razorpay lifts the ceiling for this account.
# RAZORPAY_MAX_ORDER_PAISE=50000000

# --- Cloudinary (image uploads) ---
# Create a free account at https://cloudinary.com, then copy from Dashboard.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Max upload size in bytes (default 4 MB — stays under Vercel's 4.5 MB limit).
# MAX_UPLOAD_BYTES=4194304

# --- Seed admin (used once by `npm run seed`) ---
SEED_ADMIN_EMAIL=admin@taneshabaxi.com
SEED_ADMIN_PASSWORD=change-me-strong
