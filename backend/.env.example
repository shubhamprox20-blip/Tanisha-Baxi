# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=5000

# Exact origin of the storefront (scheme + host, no trailing slash).
CLIENT_ORIGIN=http://localhost:5173

# Session cookie
JWT_SECRET=generate-a-long-random-string
JWT_EXPIRES_IN=7d
# true in production (HTTPS). Required for cross-site cookies.
COOKIE_SECURE=false

# --- Database: PostgreSQL (Neon) ---
# Neon dashboard -> Connection string -> use the POOLED host (contains "-pooler").
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require
# Leave unset. Set to false only if TLS certificate verification fails.
# DB_SSL_REJECT_UNAUTHORIZED=true
# DB_POOL_MAX=10

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880

# --- Seed admin (used once by `npm run seed`) ---
SEED_ADMIN_EMAIL=admin@taneshabaxi.com
SEED_ADMIN_PASSWORD=change-me-strong
