# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Public origin of the React frontend (used for CORS + cookie settings).
# In production set this to the real site, e.g. https://taneshabaxi.com
CLIENT_ORIGIN=http://localhost:5173

# ── Auth ──────────────────────────────────────────────────────────────────
# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Session lifetime for the auth cookie.
JWT_EXPIRES_IN=7d
# Set to "true" only when served over HTTPS (production). Locally keep "false".
COOKIE_SECURE=false

# ── Database (cPanel MySQL) ────────────────────────────────────────────────
# On cPanel these come from "MySQL Databases". Host is usually localhost.
DB_HOST=localhost
DB_PORT=3306
DB_USER=tanesha_app
DB_PASSWORD=change-me
DB_NAME=tanesha_shop
DB_CONNECTION_LIMIT=10

# ── Razorpay ───────────────────────────────────────────────────────────────
# Get these from the Razorpay dashboard. NEVER commit real keys.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Webhook secret configured in the Razorpay dashboard webhook settings.
RAZORPAY_WEBHOOK_SECRET=change-me

# ── Uploads ────────────────────────────────────────────────────────────────
# Directory (relative to backend root) where product images are stored.
UPLOAD_DIR=uploads
# Max upload size in bytes (default 5 MB).
MAX_UPLOAD_BYTES=5242880

# ── Bootstrap admin (used only by `npm run seed`) ──────────────────────────
SEED_ADMIN_EMAIL=admin@taneshabaxi.com
SEED_ADMIN_PASSWORD=change-me-strong
