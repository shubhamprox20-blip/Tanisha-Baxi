# Base URL of the API. Empty = same origin (recommended for the single-host
# cPanel deploy, where /api is reverse-proxied to the Node app). For a split
# deploy set this to the backend's public URL, e.g. https://api.taneshabaxi.com
VITE_API_BASE=

# Dev-only: where `vite dev` proxies /api and /uploads. Defaults to localhost:5000.
VITE_DEV_API_TARGET=http://localhost:5000
